# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Optional server-only Telegram bot credential. Never expose it to browser code.
# Configure the real value in the hosting provider's secret environment settings, not in this file.
TELEGRAM_BOT_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon PostgreSQL (development/testing only). Use the direct connection URL for migrations.
# Set real values in your local ignored .env file; never commit connection strings.
DATABASE_URL=""
DATABASE_URL_DIRECT=""
DB_POOL_MAX="5"
